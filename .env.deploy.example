# Settings for scripts/deploy.sh and scripts/grant.sh (see "Settings" in SETUP.md).
# Copy to .env.deploy (gitignored) and fill in. These identify your workspace; keep them out of git.

# Databricks CLI profile and bundle target
DATABRICKS_PROFILE=
BUNDLE_TARGET=free

# Bundle variables (exported as BUNDLE_VAR_<name>)
WAREHOUSE_ID=
CATALOG=workspace
SCHEMA=genie_evalops
LAKEBASE_BRANCH=projects/<project>/branches/production
LAKEBASE_ENDPOINT=projects/<project>/branches/production/endpoints/primary

# Service principals (application ids)
# Collector: reads your spaces' conversations; grant it CAN_MANAGE on each Genie space to evaluate.
COLLECTOR_SP=
# Tester: asks the eval set when you test a change. Exactly your consumers' data access
# (USE CATALOG / USE SCHEMA / SELECT on the space's tables or metric views), nothing else.
TESTER_SP=
# The app's own service principal, created by the deploy that starts the app (leave it empty
# until then): `databricks apps get genie-agent-evalops` -> service_principal_client_id.
APP_SP=

# Who may open the app (besides you, the owner): comma-separated emails, or group:<name>.
# Each listed principal must already be a user/group in the workspace. What they then see is
# still limited to the Genie spaces they hold CAN_MANAGE on.
APP_VIEWERS=

# Serving endpoint every LLM skill calls (empty = the bundle default, databricks-qwen3-next-80b-a3b-instruct).
# Changing it restarts each judge's calibration: agreement is measured per prompt and model.
JUDGE_MODEL=
# Concurrent LLM judge calls (Free Edition's pay-per-token QPS limit is low: use 1).
LLM_CONCURRENCY=2
# Time zone reviewers read "asked at" in (IANA name; UTC is always shown too).
REVIEW_TIMEZONE=UTC
# Traces queued for human review per space per run (keep it small for a demo).
REVIEW_BUDGET=30
# Your own rules, added to the built-in ones (rules about your data, judges of your space's
# instructions). Relative to the repo root; "none" = only the built-in rules. The demo: demo/criteria
EXTRA_CRITERIA_DIR=none
